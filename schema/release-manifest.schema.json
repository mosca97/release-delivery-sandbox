{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosca97.github.io/release-delivery-sandbox/schema/release-manifest.schema.json",
  "title": "Release manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "supplier",
    "supplierVersion",
    "materials"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "supplier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "supplierVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "supplierReleaseDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "description": {
      "type": "string"
    },
    "supersedes": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[A-Za-z0-9._-]+$"
    },
    "materials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "folders": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/folder"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*/[A-Za-z0-9._-]+$"
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "folder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "category",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "category": {
          "type": "string",
          "enum": [
            "sources",
            "artifacts",
            "configuration",
            "docs/technical",
            "docs/user",
            "evidence",
            "compliance",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "classificationReason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "other"
              }
            }
          },
          "then": {
            "required": [
              "classificationReason"
            ]
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "category",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "description": "Nome esatto del file che verra' caricato tra gli asset della GitHub Release."
        },
        "category": {
          "type": "string",
          "enum": [
            "sources",
            "artifacts",
            "configuration",
            "docs/technical",
            "docs/user",
            "evidence",
            "compliance",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "classificationReason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "other"
              }
            }
          },
          "then": {
            "required": [
              "classificationReason"
            ]
          }
        }
      ]
    }
  }
}
