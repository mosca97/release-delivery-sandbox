{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosca97.github.io/release-delivery-sandbox/schema/release-manifest.schema.json",
  "title": "Release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "supplier",
    "supplierVersion",
    "materials"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "supplier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "supplierVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "supplierReleaseDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "description": {
      "type": "string"
    },
    "supersedes": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[A-Za-z0-9._-]+$"
    },
    "materials": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/material"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*/[A-Za-z0-9._-]+$"
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "category",
        "description",
        "sizeBytes",
        "sha256",
        "storage"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "category": {
          "type": "string",
          "enum": [
            "sources",
            "artifacts",
            "configuration",
            "docs/technical",
            "docs/user",
            "evidence",
            "compliance",
            "other"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "classificationReason": {
          "type": "string",
          "minLength": 1
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "storage": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "path"
              ],
              "properties": {
                "type": {
                  "const": "git"
                },
                "path": {
                  "$ref": "#/$defs/repositoryPath"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "path"
              ],
              "properties": {
                "type": {
                  "const": "git-lfs"
                },
                "path": {
                  "$ref": "#/$defs/repositoryPath"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "asset"
              ],
              "properties": {
                "type": {
                  "const": "github-release"
                },
                "asset": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "packageType",
                "owner",
                "name",
                "version"
              ],
              "properties": {
                "type": {
                  "const": "github-packages"
                },
                "packageType": {
                  "type": "string",
                  "minLength": 1
                },
                "owner": {
                  "type": "string",
                  "minLength": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "uri"
              ],
              "properties": {
                "type": {
                  "const": "external"
                },
                "uri": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^\\s]+$"
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "other"
              }
            }
          },
          "then": {
            "required": [
              "classificationReason"
            ]
          }
        }
      ]
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[^\\x00]+$"
    }
  }
}
